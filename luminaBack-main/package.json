{
  "name": "auth-api",
  "version": "1.0.0",
  "description": "API de Autenticación para WorkHub MTY",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "db:migrate:hu27": "ts-node migrate_hu27_final_performance_quality.ts",
    "db:seed": "ts-node seed.ts",
    "db:seed:demo": "ts-node seed_production_demo_data.ts",
    "db:setup": "npm run db:migrate:hu27 && npm run db:seed",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.6.1",
    "fast-check": "^3.14.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
