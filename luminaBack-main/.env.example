# JWT Configuration
JWT_SECRET=your_super_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Supabase)
DATABASE_URL=database_url_here

# CORS — comma-separated allowed origins; omit to allow all (dev only)
ALLOWED_ORIGINS=https://yourapp.vercel.app,https://yourapp.com
# Backward-compatible alias also supported by the API:
# CORS_ORIGIN=https://yourapp.vercel.app

# Proxy trust — number of proxy hops between host and client (1 for Render/Railway/Heroku)
# Required for correct req.ip and rate-limiter behavior; do NOT use "true"
TRUST_PROXY=1

# Timezone for reservation window comparisons (defaults to America/Monterrey)
RESERVATION_TIMEZONE=America/Monterrey

# Check-in: comma-separated CIDR blocks allowed to check in; omit to allow any IP
CHECK_IN_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16

# Check-in window override in minutes (optional; uses hardcoded default if omitted)
# CHECK_IN_WINDOW_OVERRIDE_MINUTES=30

# Real AI recommendations/chatbot
# Required for AI map recommendations and assistant responses.
# Provider supported by this project: gemini.
# Gemini uses Google AI Studio free tier limits when billing is not enabled.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
